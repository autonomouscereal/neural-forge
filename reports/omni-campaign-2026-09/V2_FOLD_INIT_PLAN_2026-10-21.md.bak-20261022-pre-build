CREATE TABLE fold_alignment (
    id               BIGSERIAL PRIMARY KEY,
    run_id           BIGINT NOT NULL REFERENCES run(id),
    target_model_id  BIGINT NOT NULL REFERENCES model(id),
    target_layer     INTEGER NOT NULL,
    target_kind      TEXT NOT NULL,                     -- kda | gated_gqa | ffn | embed | boundary | head
    source_model_id  BIGINT NOT NULL REFERENCES model(id),
    source_layers    INTEGER[] NOT NULL,
    alignment_rule   TEXT NOT NULL,                     -- 'period:16->6' | 'floor:92->24' | 'relative_depth'
    alignment_sha256 CHAR(64) NOT NULL,                 -- sha of alignment.json
    UNIQUE (run_id, target_layer, target_kind, source_model_id)
);

CREATE TABLE fold_component (
    id                BIGSERIAL PRIMARY KEY,
    run_id            BIGINT NOT NULL REFERENCES run(id),
    target_model_id   BIGINT NOT NULL REFERENCES model(id),
    target_layer      INTEGER,                          -- NULL for embed / boundary / head
    component         TEXT NOT NULL,                    -- ffn.up | ffn.down | mixer.q_proj | ... | embed | boundary.in | head.down
    method            TEXT NOT NULL,                    -- chart | head_select | union_coreset | ridge_teacher_act | zero | mean_rows
    candidate_params  BIGINT NOT NULL,                  -- what was on offer (from tensor shapes)
    installed_params  BIGINT NOT NULL,                  -- what the child stores (from tensor shapes)
    compression       NUMERIC(12,4) GENERATED ALWAYS AS (candidate_params::numeric / NULLIF(installed_params, 0)) STORED,
    fit_rel_l2        DOUBLE PRECISION,                 -- diagnostics only
    held_rel_l2       DOUBLE PRECISION,
    held_cos          DOUBLE PRECISION,
    retained_energy   DOUBLE PRECISION,
    prefix_divergence DOUBLE PRECISION,                 -- stream_divergence.held.relL2 after this layer
    finite            BOOLEAN NOT NULL,                 -- functional
    receipt_path      TEXT NOT NULL,
    receipt_sha256    CHAR(64) NOT NULL,
    created_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT fold_component_method_not_copy CHECK (method <> 'copy'),
    CONSTRAINT fold_component_finite_or_refused CHECK (finite OR installed_params = 0)
);
CREATE INDEX fold_component_run_idx ON fold_component (run_id, target_layer);

CREATE TABLE fold_component_source (                    -- per-source share inside a union component
    fold_component_id BIGINT NOT NULL REFERENCES fold_component(id) ON DELETE CASCADE,
    source_model_id   BIGINT NOT NULL REFERENCES model(id),
    source_layers     INTEGER[] NOT NULL,
    candidate_params  BIGINT NOT NULL,
    installed_params  BIGINT NOT NULL,
    PRIMARY KEY (fold_component_id, source_model_id)
);

CREATE VIEW v_fold_compression AS
SELECT fc.run_id, m.name AS target_model, fc.target_layer, fc.component, fc.method,
       fc.candidate_params, fc.installed_params, fc.compression,
       (fc.compression >= 4.0) AS clears_4x,
       fc.held_rel_l2, fc.held_cos, fc.prefix_divergence, fc.finite
FROM fold_component fc JOIN model m ON m.id = fc.target_model_id;

GRANT SELECT ON fold_alignment, fold_component, fold_component_source, v_fold_compression TO omni_lab_ro;
```

`model_lineage` gets one `fold` edge per source (T or S5, K3D, each unit, S3/Q38 when used) to the new `co2-2b-F*` model rows, with the receipt sha; `ledger_event` mirrors the `$OC/ledger.jsonl` registration (`oc_checkpoint.py`), which stays the authority.

